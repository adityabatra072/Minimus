diff --git a/engines/llamacpp/llamacpp_backend.cpp b/engines/llamacpp/llamacpp_backend.cpp
index 07124b24b..64e43fdb9 100644
--- a/engines/llamacpp/llamacpp_backend.cpp
+++ b/engines/llamacpp/llamacpp_backend.cpp
@@ -406,9 +406,22 @@ bool LlamaCppTextGeneration::load_model(const std::string& model_path,
     if (config.contains("context_size")) {
         user_context_size = config["context_size"].get<int>();
     }
+    // commons' load_options_json() emits "context_length" for the v4 load knob
+    // (ModelLoadRequest.context_length); nothing on that path ever writes
+    // "context_size", so a caller-requested context window was silently
+    // dropped and every model loaded at the default cap.
+    if (config.contains("context_length")) {
+        user_context_size = config["context_length"].get<int>();
+    }
     if (config.contains("max_context_size")) {
         max_default_context_ = config["max_context_size"].get<int>();
     }
+    // The final size is min{fitted, train, cap}. Without this an explicit
+    // request could only ever LOWER the window: asking for 8192 on a device
+    // that fits 4096 still yielded the 2048 default cap.
+    if (user_context_size > max_default_context_) {
+        max_default_context_ = user_context_size;
+    }
 
     model_config_ = config;
     model_path_ = resolved_path;
diff --git a/engines/llamacpp/rac_backend_llamacpp_register.cpp b/engines/llamacpp/rac_backend_llamacpp_register.cpp
index e70223de4..bf5169b08 100644
--- a/engines/llamacpp/rac_backend_llamacpp_register.cpp
+++ b/engines/llamacpp/rac_backend_llamacpp_register.cpp
@@ -58,8 +58,29 @@ rac_result_t llamacpp_cpu_provider_create_session(const rac_runtime_session_desc
         return RAC_ERROR_INVALID_PATH;
     }
 
+    // Carry the caller's load knobs into the engine. Commons hands the v4
+    // ModelLoadRequest down as advisory config_json ("context_length"), and
+    // dropping it here is why models.load({ contextLength }) had no effect:
+    // every model loaded at the engine's default cap no matter what the app
+    // asked for. "context_size" is accepted too — that is the key the engine's
+    // own config uses.
+    rac_llm_llamacpp_config_t cfg = {};
+    bool have_cfg = false;
+    if (desc->options_json != nullptr && desc->options_json[0] != '\0') {
+        auto parsed = nlohmann::json::parse(desc->options_json, nullptr, /*allow_exceptions=*/false);
+        if (parsed.is_object()) {
+            for (const char* key : {"context_length", "context_size"}) {
+                if (parsed.contains(key) && parsed[key].is_number_integer()) {
+                    cfg.context_size = parsed[key].get<int32_t>();
+                    have_cfg = cfg.context_size > 0;
+                }
+            }
+        }
+    }
+
     rac_handle_t backend_handle = nullptr;
-    rac_result_t rc = rac_llm_llamacpp_create(desc->model_path, nullptr, &backend_handle);
+    rac_result_t rc =
+        rac_llm_llamacpp_create(desc->model_path, have_cfg ? &cfg : nullptr, &backend_handle);
     if (rc != RAC_SUCCESS)
         return rc;
     *out = reinterpret_cast<rac_runtime_session_t*>(backend_handle);
