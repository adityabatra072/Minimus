{
  "name": "minimus",
  "version": "0.1.0",
  "private": true,
  "description": "Minimus — on-device agentic AI demo app (iOS + Android) built on the RunAnywhere SDKs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "eval": "npm run start -w @minimus/eval --",
    "postinstall": "patch-package && node scripts/fix-runanywhere-windows.mjs"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
