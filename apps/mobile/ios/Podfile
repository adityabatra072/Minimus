# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# RunAnywhere SDK floor is iOS 17.5 (Package.swift/podspecs); RN's default
# min_ios_version_supported is lower and makes pod resolution fail.
platform :ios, '17.5'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'mobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Keep every pod at the SDK floor — some podspecs pin lower targets and
    # Xcode 26 refuses mixed deployment targets with the prebuilt frameworks.
    installer.pods_project.targets.each do |t|
      t.build_configurations.each do |bc|
        if bc.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 17.5
          bc.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.5'
        end
        # The @runanywhere pods declare swift_version 6.2 but their sources
        # trip Xcode 26's Swift-6 strict concurrency (Sendable violations in
        # HybridAudioCapture/Playback). Compile them in Swift 5 language mode
        # with minimal concurrency checking until fixed upstream.
        if t.name.start_with?('RunAnywhere')
          bc.build_settings['SWIFT_VERSION'] = '5.0'
          bc.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'minimal'
        end
        # Xcode 26 sandboxes user script phases by default, which blocks
        # CocoaPods' copy-xcframeworks phase — the vendored librac_commons.a
        # device slice never reaches XCFrameworkIntermediates and the link
        # fails. Same setting RN templates ship with.
        bc.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      end
    end
  end
end
